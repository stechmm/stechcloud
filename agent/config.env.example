# Telegram Bot Configuration
# 1. Message @BotFather on Telegram to create your bot and get the TOKEN
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Message @userinfobot on Telegram to get your numeric CHAT ID
ADMIN_CHAT_ID=your_telegram_user_id_here

# 3. Get your FREE Google Gemini AI Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Monitoring Thresholds (Alert when exceeded)
CPU_THRESHOLD=85
RAM_THRESHOLD=85
DISK_THRESHOLD=90

# Check interval in seconds (default: 180s = 3 minutes)
CHECK_INTERVAL=180

# Monitored Docker Containers (comma separated)
MONITORED_CONTAINERS=personal-cloud-app,shadowbox,pos-server

# Auto-Restart crashed containers (True / False)
AUTO_RESTART=True
